import React from 'react';
import { clrAccent1, clrAccent2 } from "../theme";

export const Sa = props => {
    return <span style={{color: clrAccent1}} {...props} />;
};

export const Sb = props => {
    return <span style={{color: clrAccent2}} {...props} />;
};

export const Ca = props => {
    return <code style={{color: clrAccent1}} {...props} />;
};

export const Cb = props => {
    return <code style={{color: clrAccent2}} {...props} />;
};
